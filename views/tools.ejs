<!-- 🔥 LLM SEO MAGIC: DYNAMIC SCHEMA MARKUP 🔥 -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Structured Legacy Financial Calculators",
      "applicationCategory": "BusinessApplication",
      "description": "Smart financial planning tools to estimate SIP and Lumpsum investment growth, compounding impact, and wealth accumulation.",
      "operatingSystem": "Web",
      "provider": {
        "@type": "Organization",
        "name": "Structured Legacy"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a SIP Calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A SIP Calculator is a financial planning tool that estimates the future value of regular monthly investments based on expected returns and investment duration."
          }
        },
        {
          "@type": "Question",
          "name": "What is a Lumpsum Calculator?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A Lumpsum Calculator estimates how a one-time investment may grow over a selected time period."
          }
        },
        {
          "@type": "Question",
          "name": "Is SIP better than Lumpsum investing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Neither approach is universally better. The appropriate choice depends on investment goals, available capital, risk tolerance, and time horizon."
          }
        },
        {
          "@type": "Question",
          "name": "Are calculator results guaranteed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Calculator results are estimates based on the information provided and assumed rates of return. Actual investment outcomes may differ."
          }
        }
      ]
    }
  ]
}
</script>

<!-- CUSTOM CSS FOR EFFECTS -->
<style>
    #loader { transition: opacity 0.6s ease-out; }
    
    .kinetic-text {
        font-size: 8rem;
        font-weight: 900;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 2px rgba(255, 255, 255, 0.08);
        animation: scrollText 30s linear infinite;
        position: absolute;
        z-index: 0;
        pointer-events: none;
    }
    @keyframes scrollText { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* Custom Range Slider */
    input[type=range] { -webkit-appearance: none; width: 100%; background: transparent; }
    input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none; height: 22px; width: 22px; border-radius: 50%;
        background: #0d47a1; cursor: pointer; margin-top: -8px; box-shadow: 0 4px 6px rgba(13,71,161,0.4);
    }
    input[type=range]::-webkit-slider-runnable-track { width: 100%; height: 6px; cursor: pointer; background: #e2e8f0; border-radius: 5px; }
    
    input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }

    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }
</style>

<div id="loader" class="fixed inset-0 z-[100] bg-[#f8fafc] flex flex-col items-center justify-center">
    <lottie-player src="https://assets2.lottiefiles.com/packages/lf20_usmfx6bp.json" background="transparent" speed="1.5" style="width: 250px; height: 250px;" loop autoplay></lottie-player>
    <h2 class="text-[#0d47a1] font-bold tracking-widest uppercase mt-4 animate-pulse">Loading Tools...</h2>
</div>

<main class="mt-[72px] overflow-x-hidden bg-[#f8fafc]">
    
    <!-- 1. HERO SECTION -->
    <section class="relative min-h-[50vh] bg-fixed bg-center bg-cover flex items-center overflow-hidden py-20" 
             style="background-image: url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2070&auto=format&fit=crop');">
        
        <div class="absolute inset-0 bg-gradient-to-b from-[#0a192f]/90 via-[#0a192f]/80 to-transparent z-0"></div>
        <div class="absolute top-1/4 left-0 w-full overflow-hidden flex z-0 opacity-40 pointer-events-none">
            <div class="kinetic-text">WEALTH CREATION • FORECASTING • FINANCIAL PLANNING • SIP CALCULATOR • LUMPSUM</div>
        </div>

        <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">
            <div class="inline-flex items-center bg-[#0d47a1]/90 text-white px-5 py-2 rounded-full text-xs md:text-sm font-bold mb-4 tracking-widest shadow-inner border border-blue-400/30 uppercase">
                <span class="w-2 h-2 rounded-full bg-blue-300 mr-3 animate-pulse"></span>
                Financial Planning Tools
            </div>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-white leading-tight mb-6 drop-shadow-lg">
                Smart Financial Planning Starts <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-blue-500">With Better Decisions.</span>
            </h1>
            <p class="text-lg md:text-xl text-blue-100 max-w-3xl mx-auto font-light leading-relaxed">
                Whether you are building wealth through regular investments or investing a lump sum amount, understanding potential future outcomes is an important part of financial planning.
            </p>
        </div>
    </section>

    <!-- 2. THE CALCULATOR COMPONENT (Intact Functionality) -->
    <section class="py-16 relative z-10 -mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="bg-white rounded-[2rem] shadow-[0_20px_50px_rgba(0,0,0,0.08)] border border-gray-100 p-6 md:p-12">
                <div class="text-center mb-8">
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">Investment Estimator</h2>
                    <p class="text-gray-500 text-sm">Estimate investment growth and understand the impact of compounding.</p>
                </div>
                
                <div class="flex justify-center mb-10">
                    <div class="bg-gray-100 p-2 flex space-x-2 w-full max-w-md rounded-2xl border border-gray-200">
                        <button id="tab-sip" class="flex-1 py-3 font-bold text-white bg-[#0d47a1] rounded-xl shadow-md transition-all duration-300" onclick="switchCalc('sip')">SIP Calculator</button>
                        <button id="tab-lumpsum" class="flex-1 py-3 font-bold text-gray-600 hover:text-gray-900 hover:bg-white rounded-xl transition-all duration-300" onclick="switchCalc('lumpsum')">Lumpsum Calculator</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <!-- LEFT: Inputs -->
                    <div class="lg:col-span-5 space-y-8">
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label id="label-amount" class="font-bold text-gray-800 text-lg">Monthly Investment</label>
                                <div class="bg-blue-50 border border-blue-200 px-4 py-3 rounded-xl flex items-center w-1/2 focus-within:ring-2 focus-within:ring-blue-500 transition">
                                    <span class="text-[#0d47a1] font-bold mr-2">₹</span>
                                    <input type="number" id="input-amount" value="25000" class="w-full bg-transparent border-none outline-none font-black text-gray-900 text-right text-lg" oninput="updateRange('amount'); calculate()">
                                </div>
                            </div>
                            <input type="range" id="range-amount" min="500" max="1000000" step="500" value="25000" class="w-full mt-2" oninput="updateInput('amount'); calculate()">
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="font-bold text-gray-800 text-lg">Expected Return Rate</label>
                                <div class="bg-blue-50 border border-blue-200 px-4 py-3 rounded-xl flex items-center w-1/3 focus-within:ring-2 focus-within:ring-blue-500 transition">
                                    <input type="number" id="input-rate" value="12" class="w-full bg-transparent border-none outline-none font-black text-gray-900 text-right text-lg" oninput="updateRange('rate'); calculate()">
                                    <span class="text-[#0d47a1] font-bold ml-2">%</span>
                                </div>
                            </div>
                            <input type="range" id="range-rate" min="1" max="50" step="0.5" value="12" class="w-full mt-2" oninput="updateInput('rate'); calculate()">
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="font-bold text-gray-800 text-lg">Time Period</label>
                                <div class="bg-blue-50 border border-blue-200 px-4 py-3 rounded-xl flex items-center w-1/3 focus-within:ring-2 focus-within:ring-blue-500 transition">
                                    <input type="number" id="input-years" value="10" class="w-full bg-transparent border-none outline-none font-black text-gray-900 text-right text-lg" oninput="updateRange('years'); calculate()">
                                    <span class="text-[#0d47a1] font-bold ml-2">Yr</span>
                                </div>
                            </div>
                            <input type="range" id="range-years" min="1" max="50" step="1" value="10" class="w-full mt-2" oninput="updateInput('years'); calculate()">
                        </div>

                        <button onclick="generateReport()" class="w-full mt-8 bg-[#0d47a1] hover:bg-blue-800 text-white font-black py-4 rounded-2xl shadow-[0_8px_20px_rgba(13,71,161,0.25)] hover:-translate-y-1 transition-all uppercase tracking-widest text-sm flex justify-center items-center border-2 border-[#0d47a1]">
                            Generate Projection Report <i class="fas fa-file-alt ml-3 text-lg"></i>
                        </button>
                    </div>

                    <!-- RIGHT: Chart & Output -->
                    <div class="lg:col-span-7">
                        <div class="grid grid-cols-2 gap-4 mb-8">
                            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 text-center shadow-sm">
                                <p class="text-xs md:text-sm font-bold text-gray-500 uppercase tracking-widest mb-2">Total Invested</p>
                                <h3 class="text-2xl md:text-3xl font-black text-gray-900" id="display-invested">₹0</h3>
                            </div>
                            <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 text-center shadow-sm">
                                <p class="text-xs md:text-sm font-bold text-[#0d47a1] uppercase tracking-widest mb-2">Est. Returns</p>
                                <h3 class="text-2xl md:text-3xl font-black text-[#0d47a1]" id="display-returns">₹0</h3>
                            </div>
                            <div class="col-span-2 bg-[#0a192f] rounded-2xl p-8 text-center shadow-xl border border-[#0d47a1] relative overflow-hidden">
                                <div class="absolute -right-10 -top-10 w-40 h-40 bg-blue-600 rounded-full blur-3xl opacity-30"></div>
                                <p class="text-sm font-bold text-[#d4af37] uppercase tracking-widest mb-2 relative z-10">Total Wealth Generated</p>
                                <h2 class="text-4xl md:text-5xl font-black text-white drop-shadow-md relative z-10" id="display-total">₹0</h2>
                            </div>
                        </div>

                        <div class="bg-white border border-gray-200 rounded-2xl p-4 h-64 md:h-80 w-full relative shadow-sm">
                            <canvas id="wealthChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- REPORT SECTION (Hidden by default) -->
    <section id="report-section" class="py-16 hidden">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center md:items-end mb-8 bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
                <div class="text-center md:text-left mb-4 md:mb-0">
                    <h3 class="text-2xl font-black text-gray-900">Detailed Projection Report</h3>
                    <p class="text-gray-500 text-sm mt-1">Review your year-by-year wealth growth trajectory.</p>
                </div>
                <button onclick="downloadPDF()" class="bg-[#0a192f] text-white px-8 py-3 rounded-xl font-bold hover:bg-black transition shadow-lg flex items-center">
                    <i class="fas fa-file-pdf mr-3 text-red-400 text-xl"></i> Download PDF
                </button>
            </div>
            
            <div class="bg-white p-8 rounded-[2rem] shadow-xl border border-gray-200">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[#0a192f] text-white text-sm uppercase tracking-wider">
                                <th class="p-4 rounded-tl-xl font-bold">Year</th>
                                <th class="p-4 font-bold">Total Invested</th>
                                <th class="p-4 font-bold">Est. Returns</th>
                                <th class="p-4 rounded-tr-xl font-bold">End Value</th>
                            </tr>
                        </thead>
                        <tbody id="report-table-body" class="text-gray-700 font-medium"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. EDUCATIONAL CONTENT SECTION (SEO Rich Text) -->
    <section class="py-20 bg-white border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
                
                <!-- Left Content -->
                <div class="space-y-12">
                    <div>
                        <h2 class="text-3xl font-black text-gray-900 mb-4">Why Investment Calculators Matter</h2>
                        <p class="text-gray-600 leading-relaxed mb-4 text-justify">
                            Financial planning often involves making decisions based on future expectations rather than current circumstances alone. Investment calculators can help provide clarity by illustrating how variables such as investment amount, time horizon, and expected returns may influence future outcomes.
                        </p>
                        <ul class="space-y-3 mt-6">
                            <li class="flex items-center text-gray-700 font-medium"><i class="fas fa-check-circle text-[#0d47a1] mr-3"></i> Understanding the power of compounding</li>
                            <li class="flex items-center text-gray-700 font-medium"><i class="fas fa-check-circle text-[#0d47a1] mr-3"></i> Comparing different investment scenarios</li>
                            <li class="flex items-center text-gray-700 font-medium"><i class="fas fa-check-circle text-[#0d47a1] mr-3"></i> Setting realistic financial goals</li>
                            <li class="flex items-center text-gray-700 font-medium"><i class="fas fa-check-circle text-[#0d47a1] mr-3"></i> Planning long-term wealth accumulation</li>
                            <li class="flex items-center text-gray-700 font-medium"><i class="fas fa-check-circle text-[#0d47a1] mr-3"></i> Evaluating investment strategies</li>
                        </ul>
                    </div>

                    <div class="bg-blue-50 p-8 rounded-3xl border border-blue-100 shadow-inner">
                        <h3 class="text-2xl font-black text-gray-900 mb-4">SIP Vs Lumpsum Investing</h3>
                        <p class="text-gray-700 leading-relaxed mb-4 text-justify">
                            Both approaches serve different financial objectives. SIP investing is often preferred when capital is accumulated gradually and regular investing is desired. Lumpsum investing may be appropriate when funds are available upfront and the investor seeks immediate market participation.
                        </p>
                        <p class="text-gray-700 leading-relaxed font-semibold italic text-justify">
                            The appropriate approach depends on individual circumstances, financial objectives, risk tolerance, and investment horizon.
                        </p>
                    </div>
                </div>

                <!-- Right Content -->
                <div class="space-y-12">
                    <div>
                        <h2 class="text-3xl font-black text-gray-900 mb-4">Understanding SIP Investing</h2>
                        <p class="text-gray-600 leading-relaxed mb-6 text-justify">
                            A Systematic Investment Plan allows investors to invest a fixed amount at regular intervals. Rather than attempting to time the market, SIP investing focuses on consistency and long-term participation.
                        </p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="border border-gray-200 rounded-2xl p-5 hover:shadow-md transition">
                                <h4 class="font-bold text-[#0d47a1] mb-2"><i class="fas fa-calendar-check mr-2"></i> Disciplined</h4>
                                <p class="text-xs text-gray-600">Regular contributions help build strict investment habits over time.</p>
                            </div>
                            <div class="border border-gray-200 rounded-2xl p-5 hover:shadow-md transition">
                                <h4 class="font-bold text-[#0d47a1] mb-2"><i class="fas fa-balance-scale mr-2"></i> Rupee Cost Averaging</h4>
                                <p class="text-xs text-gray-600">Investments are made across different market conditions automatically.</p>
                            </div>
                            <div class="border border-gray-200 rounded-2xl p-5 hover:shadow-md transition">
                                <h4 class="font-bold text-[#0d47a1] mb-2"><i class="fas fa-chart-area mr-2"></i> Compounding</h4>
                                <p class="text-xs text-gray-600">Returns generated over time contribute to significant long-term growth.</p>
                            </div>
                            <div class="border border-gray-200 rounded-2xl p-5 hover:shadow-md transition">
                                <h4 class="font-bold text-[#0d47a1] mb-2"><i class="fas fa-door-open mr-2"></i> Accessibility</h4>
                                <p class="text-xs text-gray-600">SIPs allow investors to begin investing with relatively small amounts.</p>
                            </div>
                        </div>
                    </div>

                    <div>
                        <h2 class="text-3xl font-black text-gray-900 mb-4">Understanding Lumpsum Investing</h2>
                        <p class="text-gray-600 leading-relaxed mb-6 text-justify">
                            Lumpsum investing involves investing a larger amount of capital at one time. This approach may be suitable when funds are already available and the investor has a long-term investment horizon.
                        </p>
                        <div class="space-y-4">
                            <div class="flex items-start">
                                <i class="fas fa-rocket text-[#0d47a1] mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h4 class="font-bold text-gray-900">Immediate Market Exposure</h4>
                                    <p class="text-sm text-gray-600">The entire investment begins participating in the market immediately.</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <i class="fas fa-seedling text-[#0d47a1] mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h4 class="font-bold text-gray-900">Potential For Long-Term Growth</h4>
                                    <p class="text-sm text-gray-600">Long investment periods may enhance compounding benefits significantly.</p>
                                </div>
                            </div>
                            <div class="flex items-start">
                                <i class="fas fa-check-double text-[#0d47a1] mt-1 mr-4 text-xl"></i>
                                <div>
                                    <h4 class="font-bold text-gray-900">Simplicity</h4>
                                    <p class="text-sm text-gray-600">A single investment transaction can be much easier to manage and track.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- 4. FAQ SECTION (LLM SEO Optimized) -->
    <section class="py-24 bg-[#e0e5ec] relative">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <span class="text-[#0d47a1] font-bold tracking-widest uppercase text-sm mb-2 block">Knowledge Base</span>
                <h2 class="text-4xl font-black text-gray-900">Frequently Asked Questions</h2>
            </div>
            
            <div class="space-y-4">
                <details class="group bg-white border border-gray-200 rounded-2xl open:shadow-md transition-all duration-300" open>
                    <summary class="flex justify-between items-center font-bold p-6 md:p-8 text-gray-900 cursor-pointer text-lg">
                        <span>What is a SIP Calculator?</span>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-[#0d47a1] bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shadow-sm flex-shrink-0 ml-4"><i class="fas fa-chevron-down"></i></span>
                    </summary>
                    <div class="text-gray-700 p-6 md:p-8 pt-0 leading-relaxed text-base border-t border-gray-100 mt-2">
                        A Systematic Investment Plan (SIP) Calculator is a financial planning tool that estimates the future value of regular monthly investments based on expected returns and investment duration.
                    </div>
                </details>
                
                <details class="group bg-white border border-gray-200 rounded-2xl open:shadow-md transition-all duration-300">
                    <summary class="flex justify-between items-center font-bold p-6 md:p-8 text-gray-900 cursor-pointer text-lg">
                        <span>What is a Lumpsum Calculator?</span>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-[#0d47a1] bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shadow-sm flex-shrink-0 ml-4"><i class="fas fa-chevron-down"></i></span>
                    </summary>
                    <div class="text-gray-700 p-6 md:p-8 pt-0 leading-relaxed text-base border-t border-gray-100 mt-2">
                        A Lumpsum Calculator estimates how a one-time investment may grow over a selected time period. It is useful for evaluating how single investments grow under different return assumptions.
                    </div>
                </details>

                <details class="group bg-white border border-gray-200 rounded-2xl open:shadow-md transition-all duration-300">
                    <summary class="flex justify-between items-center font-bold p-6 md:p-8 text-gray-900 cursor-pointer text-lg">
                        <span>Are calculator results guaranteed?</span>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-[#0d47a1] bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shadow-sm flex-shrink-0 ml-4"><i class="fas fa-chevron-down"></i></span>
                    </summary>
                    <div class="text-gray-700 p-6 md:p-8 pt-0 leading-relaxed text-base border-t border-gray-100 mt-2">
                        No. Calculator results are estimates based on the information provided and assumed rates of return. Actual investment outcomes may differ based on market conditions.
                    </div>
                </details>

                <details class="group bg-white border border-gray-200 rounded-2xl open:shadow-md transition-all duration-300">
                    <summary class="flex justify-between items-center font-bold p-6 md:p-8 text-gray-900 cursor-pointer text-lg">
                        <span>Is SIP better than Lumpsum investing?</span>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-[#0d47a1] bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shadow-sm flex-shrink-0 ml-4"><i class="fas fa-chevron-down"></i></span>
                    </summary>
                    <div class="text-gray-700 p-6 md:p-8 pt-0 leading-relaxed text-base border-t border-gray-100 mt-2">
                        Neither approach is universally better. The appropriate choice depends on investment goals, available capital, risk tolerance, and time horizon.
                    </div>
                </details>

                <details class="group bg-white border border-gray-200 rounded-2xl open:shadow-md transition-all duration-300">
                    <summary class="flex justify-between items-center font-bold p-6 md:p-8 text-gray-900 cursor-pointer text-lg">
                        <span>Can these calculators be used for financial planning?</span>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-[#0d47a1] bg-blue-50 w-10 h-10 rounded-full flex items-center justify-center shadow-sm flex-shrink-0 ml-4"><i class="fas fa-chevron-down"></i></span>
                    </summary>
                    <div class="text-gray-700 p-6 md:p-8 pt-0 leading-relaxed text-base border-t border-gray-100 mt-2">
                        These tools can heavily support planning and decision-making by offering projections, but they should not be considered strict financial advice.
                    </div>
                </details>
            </div>
            
            <div class="mt-12 text-center text-xs text-gray-500 bg-white p-6 rounded-2xl border border-gray-300">
                <span class="font-bold text-gray-700 block mb-2 uppercase tracking-widest">Important Disclaimer</span>
                The information and estimates provided by these calculators are for educational and illustrative purposes only. Actual investment performance may vary based on market conditions and other factors. Users should evaluate their own circumstances before making financial decisions.
            </div>
        </div>
    </section>

    <!-- 5. CTA / BEYOND CALCULATORS -->
    <section class="relative py-24 md:py-32 bg-fixed bg-center bg-cover flex items-center shadow-[inset_0_0_80px_rgba(0,0,0,0.9)]" 
