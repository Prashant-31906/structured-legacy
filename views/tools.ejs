<!-- ADVANCED CALCULATOR LOGIC -->
<script>
    let currentMode = 'sip'; // sip, yearly, lumpsum
    let wealthChart;
    let reportDataRows = []; 
    let finalPhase1Value = 0; // Stores value after investment phase

    const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(num));

    function updateInput(id) { document.getElementById(`input-${id}`).value = document.getElementById(`range-${id}`).value; }
    function updateRange(id) { document.getElementById(`range-${id}`).value = document.getElementById(`input-${id}`).value; }

    function switchCalc(mode) {
        currentMode = mode;
        
        // Reset Tabs styling
        ['sip', 'yearly', 'lumpsum'].forEach(m => {
            document.getElementById(`tab-${m}`).className = 'flex-1 py-3 px-2 font-bold text-gray-600 hover:text-gray-900 hover:bg-white rounded-xl transition-all duration-300';
        });
        document.getElementById(`tab-${mode}`).className = 'flex-1 py-3 px-2 font-bold text-white bg-[#0d47a1] rounded-xl shadow-md transition-all duration-300';

        const labelAmount = document.getElementById('label-amount');
        const labelYears = document.getElementById('label-years');
        const holdContainer = document.getElementById('hold-period-container');

        if(mode === 'sip') {
            labelAmount.innerText = 'Monthly Investment';
            labelYears.innerText = 'Investment Period';
            holdContainer.style.display = 'block';
            if(document.getElementById('input-amount').value >= 100000) {
                document.getElementById('input-amount').value = 25000;
                document.getElementById('range-amount').value = 25000;
            }
        } else if (mode === 'yearly') {
            labelAmount.innerText = 'Annual Investment';
            labelYears.innerText = 'Investment Period';
            holdContainer.style.display = 'block';
            if(document.getElementById('input-amount').value <= 50000) {
                document.getElementById('input-amount').value = 300000;
                document.getElementById('range-amount').value = 300000;
            }
        } else {
            labelAmount.innerText = 'One-Time Lumpsum';
            labelYears.innerText = 'Total Duration';
            holdContainer.style.display = 'none'; // Hide hold period for pure lumpsum
            document.getElementById('input-hold').value = 0;
            document.getElementById('range-hold').value = 0;
            if(document.getElementById('input-amount').value <= 100000) {
                document.getElementById('input-amount').value = 1000000;
                document.getElementById('range-amount').value = 1000000;
            }
        }
        calculate();
    }

    function calculate() {
        document.getElementById('report-section').classList.add('hidden');

        const amount = parseFloat(document.getElementById('input-amount').value) || 0;
        const rate = parseFloat(document.getElementById('input-rate').value) || 0;
        const invYears = parseFloat(document.getElementById('input-years').value) || 0;
        const holdYears = currentMode === 'lumpsum' ? 0 : (parseFloat(document.getElementById('input-hold').value) || 0);

        let totalInvested = 0;
        finalPhase1Value = 0;

        // --- PHASE 1: INVESTMENT ---
        if (currentMode === 'sip') {
            const months = invYears * 12;
            const monthlyRate = rate / 12 / 100;
            totalInvested = amount * months;
            finalPhase1Value = monthlyRate === 0 ? totalInvested : amount * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate) * (1 + monthlyRate);
        } else if (currentMode === 'yearly') {
            const yearlyRate = rate / 100;
            totalInvested = amount * invYears;
            finalPhase1Value = yearlyRate === 0 ? totalInvested : amount * ((Math.pow(1 + yearlyRate, invYears) - 1) / yearlyRate) * (1 + yearlyRate);
        } else { // lumpsum
            const yearlyRate = rate / 100;
            totalInvested = amount;
            finalPhase1Value = amount * Math.pow(1 + yearlyRate, invYears); // For lumpsum, invYears acts as total duration
        }

        // --- PHASE 2: HOLDING (Only applies to SIP and Yearly) ---
        let totalValue = finalPhase1Value;
        if (holdYears > 0) {
            const yearlyRate = rate / 100;
            totalValue = finalPhase1Value * Math.pow(1 + yearlyRate, holdYears);
            document.getElementById('hold-badge').classList.remove('hidden');
        } else {
            document.getElementById('hold-badge').classList.add('hidden');
        }

        const estReturns = totalValue - totalInvested;

        document.getElementById('display-invested').innerText = '₹' + formatCurrency(totalInvested);
        document.getElementById('display-returns').innerText = '₹' + formatCurrency(estReturns);
        document.getElementById('display-total').innerText = '₹' + formatCurrency(totalValue);

        updateChart(totalInvested, estReturns);
    }

    function updateChart(invested, returns) {
        const ctx = document.getElementById('wealthChart').getContext('2d');
        if (wealthChart) wealthChart.destroy();

        wealthChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Total Invested', 'Est. Returns'],
                datasets: [{
                    data: [invested, returns],
                    backgroundColor: ['#94a3b8', '#0d47a1'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 20, font: { weight: 'bold' } } },
                    tooltip: { callbacks: { label: function(context) { return ' ₹' + formatCurrency(context.raw); } } }
                }
            }
        });
    }

    function generateReport() {
        const amount = parseFloat(document.getElementById('input-amount').value) || 0;
        const rate = parseFloat(document.getElementById('input-rate').value) || 0;
        const invYears = parseFloat(document.getElementById('input-years').value) || 0;
        const holdYears = currentMode === 'lumpsum' ? 0 : (parseFloat(document.getElementById('input-hold').value) || 0);
        const totalYears = invYears + holdYears;

        const tbody = document.getElementById('report-table-body');
        tbody.innerHTML = ''; 
        reportDataRows = []; 

        let cumulativeInvested = 0;
        let cumulativeValue = 0;
        let phaseLabel = "";

        for (let y = 1; y <= totalYears; y++) {
            
            if (y <= invYears) {
                // Investment Phase
                phaseLabel = `<span class="bg-green-100 text-green-700 text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Investing</span>`;
                if (currentMode === 'sip') {
                    const months = y * 12;
                    const monthlyRate = rate / 12 / 100;
                    cumulativeInvested = amount * months;
                    cumulativeValue = monthlyRate === 0 ? cumulativeInvested : amount * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate) * (1 + monthlyRate);
                } else if (currentMode === 'yearly') {
                    const yearlyRate = rate / 100;
                    cumulativeInvested = amount * y;
                    cumulativeValue = yearlyRate === 0 ? cumulativeInvested : amount * ((Math.pow(1 + yearlyRate, y) - 1) / yearlyRate) * (1 + yearlyRate);
                } else { // lumpsum
                    const yearlyRate = rate / 100;
                    cumulativeInvested = amount;
                    cumulativeValue = amount * Math.pow(1 + yearlyRate, y);
                    phaseLabel = `<span class="bg-blue-100 text-blue-700 text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Compounding</span>`;
                }
            } else {
                // Hold Phase (No new investments)
                phaseLabel = `<span class="bg-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider">Holding</span>`;
                const holdYearCount = y - invYears;
                const yearlyRate = rate / 100;
                cumulativeValue = finalPhase1Value * Math.pow(1 + yearlyRate, holdYearCount);
            }

            const estReturns = cumulativeValue - cumulativeInvested;
            
            reportDataRows.push({
                year: y,
                phaseStr: y <= invYears ? (currentMode==='lumpsum'?'Compound':'Invest') : 'Hold',
                invested: '₹' + formatCurrency(cumulativeInvested),
                returns: '₹' + formatCurrency(estReturns),
                total: '₹' + formatCurrency(cumulativeValue)
            });

            const bgClass = y % 2 === 0 ? 'bg-gray-50' : 'bg-white';
            const textHighlight = y > invYears && currentMode !== 'lumpsum' ? 'text-indigo-900 bg-indigo-50/30' : '';

            tbody.innerHTML += `
                <tr class="${bgClass} ${textHighlight} border-b border-gray-100 hover:bg-blue-50 transition-colors">
                    <td class="p-4 font-bold text-gray-900">Year ${y}</td>
                    <td class="p-4">${phaseLabel}</td>
                    <td class="p-4">₹${formatCurrency(cumulativeInvested)}</td>
                    <td class="p-4 text-[#0d47a1] font-bold">₹${formatCurrency(estReturns)}</td>
                    <td class="p-4 font-black text-gray-900">₹${formatCurrency(cumulativeValue)}</td>
                </tr>
            `;
        }

        const reportSec = document.getElementById('report-section');
        reportSec.classList.remove('hidden');
        reportSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

// ================= SEAMLESS BACKEND PUPPETEER TRIGGER ================= //
    async function downloadPDF() {
        Swal.fire({
            title: 'Generating Report...',
            html: 'Connecting to server engine to print your premium PDF configuration.',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        let reportName = currentMode === 'sip' ? 'Monthly SIP' : (currentMode === 'yearly' ? 'Annual SIP' : 'One-Time Lumpsum');

        // Prepare structured payload parameters for backend routing
        const payload = {
            reportType: `${reportName} Forecast Masterclass`,
            invested: document.getElementById('display-invested').innerText,
            returns: document.getElementById('display-returns').innerText,
            total: document.getElementById('display-total').innerText,
            rows: reportDataRows // Captured from generation looping sequence
        };

        try {
            const response = await fetch('/api/download-pdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error('Server compilation pipeline broke');

            // Receive binary file context array stream
            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            
            // Invisible anchor context download execution trigger
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = `Structured_Legacy_${reportName.replace(/ /g, '_')}_Report.pdf`;
            document.body.appendChild(a);
            a.click();
            
            // Clean dynamic references layout nodes array allocation
            window.URL.revokeObjectURL(url);
            document.body.removeChild(a);
            
            Swal.fire({
                icon: 'success',
                title: 'Report Compiled!',
                text: 'Your corporate wealth forecast matrix PDF downloaded successfully.',
                confirmButtonColor: '#0d47a1'
            });

        } catch (error) {
            console.error("PDF System Error:", error);
            Swal.fire({ 
                icon: 'error', 
                title: 'Execution Failed', 
                text: 'Something broke inside the server container process.' 
            });
        }
    }

    window.addEventListener('load', () => {
        setTimeout(() => {
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => { loader.style.display = 'none'; calculate(); }, 600);
        }, 1000); 
    });
</script>

