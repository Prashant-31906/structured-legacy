<!-- CALCULATOR LOGIC (Unchanged) -->
<script>
    let currentMode = 'sip'; 
    let wealthChart;
    let reportDataRows = []; 

    const formatCurrency = (num) => new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(num));

    function updateInput(id) { document.getElementById(`input-${id}`).value = document.getElementById(`range-${id}`).value; }
    function updateRange(id) { document.getElementById(`range-${id}`).value = document.getElementById(`input-${id}`).value; }

    function switchCalc(mode) {
        currentMode = mode;
        const btnSip = document.getElementById('tab-sip');
        const btnLump = document.getElementById('tab-lumpsum');
        const labelAmount = document.getElementById('label-amount');

        if(mode === 'sip') {
            btnSip.className = 'flex-1 py-3 font-bold text-white bg-[#0d47a1] rounded-xl shadow-md transition-all duration-300';
            btnLump.className = 'flex-1 py-3 font-bold text-gray-600 hover:text-gray-900 hover:bg-white rounded-xl transition-all duration-300';
            labelAmount.innerText = 'Monthly Investment';
        } else {
            btnLump.className = 'flex-1 py-3 font-bold text-white bg-[#0d47a1] rounded-xl shadow-md transition-all duration-300';
            btnSip.className = 'flex-1 py-3 font-bold text-gray-600 hover:text-gray-900 hover:bg-white rounded-xl transition-all duration-300';
            labelAmount.innerText = 'Total Investment';
            if(document.getElementById('input-amount').value == 25000) {
                document.getElementById('input-amount').value = 500000;
                document.getElementById('range-amount').value = 500000;
            }
        }
        calculate();
    }

    function calculate() {
        document.getElementById('report-section').classList.add('hidden');

        const amount = parseFloat(document.getElementById('input-amount').value) || 0;
        const rate = parseFloat(document.getElementById('input-rate').value) || 0;
        const years = parseFloat(document.getElementById('input-years').value) || 0;

        let totalInvested = 0, totalValue = 0;

        if (currentMode === 'sip') {
            const months = years * 12;
            const monthlyRate = rate / 12 / 100;
            totalInvested = amount * months;
            totalValue = monthlyRate === 0 ? totalInvested : amount * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate) * (1 + monthlyRate);
        } else {
            totalInvested = amount;
            totalValue = amount * Math.pow(1 + rate/100, years);
        }

        const estReturns = totalValue - totalInvested;

        document.getElementById('display-invested').innerText = '₹' + formatCurrency(totalInvested);
        document.getElementById('display-returns').innerText = '₹' + formatCurrency(estReturns);
        document.getElementById('display-total').innerText = '₹' + formatCurrency(totalValue);

        updateChart(totalInvested, estReturns);
    }

    function updateChart(invested, returns) {
        const ctx = document.getElementById('wealthChart').getContext('2d');
        if (wealthChart) wealthChart.destroy();

        wealthChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Total Invested', 'Est. Returns'],
                datasets: [{
                    data: [invested, returns],
                    backgroundColor: ['#94a3b8', '#0d47a1'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, cutout: '75%',
                plugins: {
                    legend: { position: 'bottom', labels: { padding: 20, font: { weight: 'bold' } } },
                    tooltip: { callbacks: { label: function(context) { return ' ₹' + formatCurrency(context.raw); } } }
                }
            }
        });
    }

    function generateReport() {
        const amount = parseFloat(document.getElementById('input-amount').value) || 0;
        const rate = parseFloat(document.getElementById('input-rate').value) || 0;
        const years = parseFloat(document.getElementById('input-years').value) || 0;

        const tbody = document.getElementById('report-table-body');
        tbody.innerHTML = ''; 
        reportDataRows = []; 

        let cumulativeInvested = 0, cumulativeValue = 0;

        for (let y = 1; y <= years; y++) {
            if (currentMode === 'sip') {
                const months = y * 12;
                const monthlyRate = rate / 12 / 100;
                cumulativeInvested = amount * months;
                cumulativeValue = monthlyRate === 0 ? cumulativeInvested : amount * ((Math.pow(1 + monthlyRate, months) - 1) / monthlyRate) * (1 + monthlyRate);
            } else {
                cumulativeInvested = amount;
                cumulativeValue = amount * Math.pow(1 + rate/100, y);
            }

            const estReturns = cumulativeValue - cumulativeInvested;
            
            reportDataRows.push({
                year: y,
                invested: '₹' + formatCurrency(cumulativeInvested),
                returns: '₹' + formatCurrency(estReturns),
                total: '₹' + formatCurrency(cumulativeValue)
            });

            const bgClass = y % 2 === 0 ? 'bg-gray-50' : 'bg-white';
            tbody.innerHTML += `
                <tr class="${bgClass} border-b border-gray-100 hover:bg-blue-50 transition-colors">
                    <td class="p-4 font-bold text-gray-900">${y}</td>
                    <td class="p-4">₹${formatCurrency(cumulativeInvested)}</td>
                    <td class="p-4 text-[#0d47a1] font-bold">₹${formatCurrency(estReturns)}</td>
                    <td class="p-4 font-black text-gray-900">₹${formatCurrency(cumulativeValue)}</td>
                </tr>
            `;
        }

        const reportSec = document.getElementById('report-section');
        reportSec.classList.remove('hidden');
        reportSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function downloadPDF() {
        Swal.fire({
            title: 'Generating Report...',
            html: 'Compiling your financial data into a premium PDF.',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        const payload = {
            reportType: currentMode === 'sip' ? 'SIP Investment Forecast' : 'Lumpsum Investment Forecast',
            invested: document.getElementById('display-invested').innerText,
            returns: document.getElementById('display-returns').innerText,
            total: document.getElementById('display-total').innerText,
            rows: reportDataRows
        };

        try {
            const response = await fetch('/api/download-pdf', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) throw new Error('Failed to generate PDF');

            const blob = await response.blob();
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.style.display = 'none';
            a.href = url;
            a.download = payload.reportType.split(' ')[0] + '_Report.pdf';
            document.body.appendChild(a);
            a.click();
            window.URL.revokeObjectURL(url);
            
            Swal.fire({
                icon: 'success',
                title: 'Downloaded!',
                text: 'Your PDF report is ready.',
                confirmButtonColor: '#0d47a1'
            });

        } catch (error) {
            console.error(error);
            Swal.fire({ icon: 'error', title: 'Oops...', text: 'Something went wrong while generating the PDF.' });
        }
    }

    window.addEventListener('load', () => {
        setTimeout(() => {
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => { loader.style.display = 'none'; calculate(); }, 600);
        }, 1000); 
    });
</script>

