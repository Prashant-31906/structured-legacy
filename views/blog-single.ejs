<%- include('partials/header') %>

<main class="mt-[72px] bg-white min-h-screen">
    
    <!-- Dynamic Blog Hero -->
    <section class="relative h-[60vh] bg-center bg-cover flex items-end pb-16" 
             style="background-image: url('<%= blog.image %>');">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a192f] via-[#0a192f]/70 to-transparent z-0"></div>
        
        <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center">
            <span class="bg-[#0d47a1] text-white px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest shadow-lg mb-6 inline-block">
                <%= blog.category %>
            </span>
            <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-6 drop-shadow-lg">
                <%= blog.title %>
            </h1>
            <div class="flex items-center justify-center text-blue-200 text-sm font-bold tracking-wider uppercase space-x-6">
                <span><i class="far fa-calendar-alt mr-2"></i> <%= blog.date %></span>
                <span><i class="far fa-clock mr-2"></i> 5 Min Read</span>
            </div>
        </div>
    </section>

    <!-- Reading Container -->
    <section class="py-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Share Buttons -->
            <div class="flex justify-center space-x-4 mb-12 pb-8 border-b border-gray-100">
                <a href="#" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-500 hover:bg-[#1DA1F2] hover:text-white transition"><i class="fab fa-twitter"></i></a>
                <a href="#" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-500 hover:bg-[#0077b5] hover:text-white transition"><i class="fab fa-linkedin-in"></i></a>
                <a href="#" class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-500 hover:bg-[#25D366] hover:text-white transition"><i class="fas fa-link"></i></a>
            </div>

            <!-- Main Dynamic Content -->
            <!-- We use <%- %> instead of <%= %> so it renders HTML tags correctly -->
            <article class="prose prose-lg md:prose-xl prose-blue max-w-none text-gray-700 leading-relaxed text-justify">
                <%- blog.content %>
            </article>

            <!-- Bottom CTA -->
            <div class="mt-20 bg-blue-50 p-10 rounded-[2rem] text-center border border-blue-100">
                <h3 class="text-2xl font-black text-gray-900 mb-4">Need personalized advice on this topic?</h3>
                <p class="text-gray-600 mb-8">Connect with our advisory board to implement these strategies in your own corporate structure.</p>
                <a href="/contact" class="bg-[#0d47a1] text-white px-8 py-4 rounded-xl font-bold hover:bg-blue-900 transition shadow-lg">Schedule Consultation</a>
            </div>

        </div>
    </section>

</main>

<%- include('partials/footer') %>