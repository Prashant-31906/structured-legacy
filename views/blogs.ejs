<%- include('partials/header') %>

<main class="mt-[72px] bg-[#f8fafc] min-h-screen">
    
    <!-- Hero Header -->
    <section class="bg-[#0a192f] py-24 relative overflow-hidden">
        <div class="absolute inset-0 bg-blue-900/20 mix-blend-multiply z-0"></div>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <span class="text-blue-400 font-bold tracking-widest uppercase text-sm mb-4 block">Knowledge Base</span>
            <h1 class="text-5xl md:text-6xl font-extrabold text-white mb-6">Premium Insights</h1>
            <p class="text-xl text-blue-100 max-w-2xl mx-auto font-light leading-relaxed">
                Expert perspectives on legacy protection, corporate tax strategies, and exponential wealth creation.
            </p>
        </div>
    </section>

    <!-- Blogs Grid -->
    <section class="py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                
                <% if(typeof blogs !== 'undefined' && blogs.length > 0) { %>
                    <% blogs.forEach(blog => { %>
                        <div class="bg-white rounded-[2rem] overflow-hidden group cursor-pointer border border-gray-100 shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 flex flex-col h-full">
                            <div class="h-64 overflow-hidden relative">
                                <img src="<%= blog.image %>" alt="<%= blog.title %>" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                                <div class="absolute inset-0 bg-gradient-to-t from-[#0a192f] via-transparent to-transparent opacity-90"></div>
                                <div class="absolute top-4 left-4">
                                    <span class="bg-white/20 backdrop-blur-md border border-white/40 text-white px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest shadow-lg">
                                        <%= blog.category %>
                                    </span>
                                </div>
                            </div>
                            <div class="p-8 flex flex-col flex-grow justify-between">
                                <div>
                                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3 block"><i class="far fa-calendar-alt mr-2"></i><%= blog.date %></span>
                                    <h4 class="text-2xl font-bold text-gray-900 mb-4 leading-tight group-hover:text-[#0d47a1] transition-colors"><%= blog.title %></h4>
                                    <p class="text-gray-600 text-sm mb-6 line-clamp-3 leading-relaxed"><%= blog.excerpt %></p>
                                </div>
                                <div class="pt-6 border-t border-gray-100 mt-auto">
                                    <a href="/blogs/<%= blog.slug %>" class="text-[#0d47a1] font-bold text-sm uppercase tracking-widest flex items-center group/link">
                                        Read Masterclass <i class="fas fa-arrow-right ml-2 transform group-hover/link:translate-x-2 transition-transform"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full text-center py-20 border-2 border-dashed border-gray-300 rounded-[2rem] bg-white">
                        <i class="fas fa-folder-open text-4xl text-gray-300 mb-4"></i>
                        <h3 class="text-2xl font-bold text-gray-600">No Articles Yet</h3>
                        <p class="text-gray-500 mt-2">The admin hasn't published any masterclasses yet.</p>
                        <a href="/admin/add-blog" class="inline-block mt-6 text-[#0d47a1] font-bold underline">Publish the first one &rarr;</a>
                    </div>
                <% } %>

            </div>
        </div>
    </section>

</main>

<%- include('partials/footer') %>