<%- include('partials/header') %>

<main class="mt-[72px] bg-[#f8fafc] min-h-[calc(100vh-72px)] flex flex-col justify-between">
    <!-- Hero / Header Section -->
    <section class="bg-[#0a192f] py-16 md:py-20 relative overflow-hidden">
        <div class="absolute inset-0 bg-blue-900/20 mix-blend-multiply z-0"></div>
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-[#d4af37]/10 rounded-full blur-3xl pointer-events-none"></div>
        
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
            <div class="inline-flex items-center bg-white/10 backdrop-blur-md text-blue-200 px-4 py-1.5 rounded-full text-xs font-bold tracking-widest uppercase mb-4 border border-white/10">
                <i class="fas fa-shield-alt mr-2 text-[#d4af37]"></i> Confidentiality & Trust
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight mb-4">
                Privacy Policy
            </h1>
            <p class="text-blue-200/80 text-sm md:text-base font-medium tracking-wide">
                Structured Legacy Commitment to Discretion & Data Protection
            </p>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 flex-grow">
        <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-3xl p-8 md:p-14 shadow-xl border border-gray-100 relative overflow-hidden">
                <!-- Decorative Top Accent Bar -->
                <div class="absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r from-[#0d47a1] via-[#1e40af] to-[#d4af37]"></div>
                
                <div class="flex items-center gap-4 mb-8 pb-6 border-b border-gray-100">
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#0d47a1] flex items-center justify-center text-xl shadow-inner border border-blue-100/60">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div>
                        <h2 class="text-xl md:text-2xl font-bold text-gray-900">Privacy & Confidentiality</h2>
                        <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold">Statement of Commitment</span>
                    </div>
                </div>

                <div class="space-y-6 text-gray-700 text-base md:text-lg leading-relaxed font-normal">
                    <p class="leading-relaxed">
                        Structured Legacy (“we,” “our,” or “us”) respects your privacy and is committed to protecting the personal information you share with us.
                    </p>
                    <p class="leading-relaxed">
                        We understand that succession planning and wealth preservation may involve confidential business, family, financial, and ownership information.
                    </p>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/footer') %>
