<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title != 'undefined' ? title : 'Structured Legacy' %></title>
    <meta name="title" content="<%= typeof title != 'undefined' ? title : 'Structured Legacy | Wealth Preservation & Legacy Advisory' %>">
    <meta name="description" content="<%= typeof description != 'undefined' ? description : 'Boutique Wealth Preservation & Legacy Advisory Firm helping business owners, promoters, and families protect wealth, plan succession, and ensure business continuity.' %>">
    <meta name="keywords" content="Succession Planning, Wealth Preservation, Business Continuity, Estate Liquidity, Family Governance, Structured Legacy, Family Office India">
    <meta name="author" content="Ved - Structured Legacy">
    <meta name="robots" content="index, follow">

    <link rel="canonical" href="<%= typeof currentUrl != 'undefined' ? currentUrl : 'https://www.structuredlegacy.com' %>" />

    <meta property="og:type" content="<%= typeof ogType != 'undefined' ? ogType : 'website' %>">
    <meta property="og:url" content="<%= typeof currentUrl != 'undefined' ? currentUrl : 'https://www.structuredlegacy.com' %>">
    <meta property="og:title" content="<%= typeof title != 'undefined' ? title : 'Structured Legacy | Wealth Preservation & Legacy Advisory' %>">
    <meta property="og:description" content="<%= typeof description != 'undefined' ? description : 'Boutique Wealth Preservation & Legacy Advisory Firm helping business owners, promoters, and families protect wealth, plan succession, and ensure business continuity.' %>">
    <meta property="og:image" content="<%= typeof ogImage != 'undefined' ? ogImage : 'https://www.structuredlegacy.com/images/structured-legacy-logo.png' %>">
    <meta property="og:site_name" content="Structured Legacy">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="<%= typeof currentUrl != 'undefined' ? currentUrl : 'https://www.structuredlegacy.com' %>">
    <meta property="twitter:title" content="<%= typeof title != 'undefined' ? title : 'Structured Legacy | Wealth Preservation & Legacy Advisory' %>">
    <meta property="twitter:description" content="<%= typeof description != 'undefined' ? description : 'Boutique Wealth Preservation & Legacy Advisory Firm helping business owners, promoters, and families protect wealth, plan succession, and ensure business continuity.' %>">
    <meta property="twitter:image" content="<%= typeof ogImage != 'undefined' ? ogImage : 'https://www.structuredlegacy.com/images/structured-legacy-logo.png' %>">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://unpkg.com/scrollreveal"></script>
</head>
<body class="bg-[#fcfdfd] font-sans antialiased text-gray-800 overflow-x-hidden">

<nav class="bg-white/90 backdrop-blur-lg border-b border-gray-100 shadow-sm fixed w-full top-0 z-50 transition-all duration-300" id="navbar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
            
            <div class="flex-shrink-0 flex items-center">
                <a href="/" class="flex items-center gap-2 md:gap-3 group">
                    <div class="relative h-10 w-8 md:h-12 md:w-10 overflow-hidden flex items-center justify-center">
                        <img src="/images/structured-legacy-logo.png" alt="SL Logo" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-110 drop-shadow-md">
                    </div>
                    <div class="flex flex-col justify-center mt-1">
                        <span class="text-lg md:text-xl font-black text-[#0d47a1] tracking-tight leading-none group-hover:text-blue-800 transition-colors">
                            STRUCTURED LEGACY
                        </span>
                        <span class="text-[10px] md:text-xs font-bold text-gray-500 tracking-[0.25em] leading-none mt-1 uppercase">
                            Protecting Wealth Preserving Legacy
                        </span>
                    </div>
                </a>
            </div>
            
            <div class="hidden md:flex space-x-8 items-center" id="desktop-menu-links">
                <a href="/" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    Home
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
                <a href="/about" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    About Us
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
                <a href="/services" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    Services
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
                <a href="/tools" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    Tools
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
                <a href="/blogs" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    Blogs
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
                <a href="/contact" class="relative nav-link text-gray-600 font-medium group transition-colors hover:text-[#0d47a1]">
                    Contact
                    <span class="absolute left-0 -bottom-1 h-0.5 bg-[#0d47a1] transition-all duration-300 w-0 group-hover:w-full nav-indicator"></span>
                </a>
            </div>

            <div class="hidden md:flex">
                <a href="/contact" class="bg-[#0d47a1] text-white px-7 py-2.5 rounded-xl font-bold tracking-wide hover:bg-blue-800 transition-all duration-300 shadow-[0_4px_14px_0_rgba(13,71,161,0.39)] hover:shadow-[0_6px_20px_rgba(13,71,161,0.23)] hover:-translate-y-0.5">
                    Get Started
                </a>
            </div>

            <div class="md:hidden flex items-center">
                <button id="mobile-menu-btn" class="text-[#0d47a1] bg-blue-50 p-2 rounded-lg focus:outline-none hover:bg-blue-100 transition-colors">
                    <i class="fas fa-bars text-xl"></i>
                </button>
            </div>
        </div>
    </div>

    <div id="mobile-menu" class="hidden md:hidden bg-white/95 backdrop-blur-xl border-t border-gray-100 shadow-2xl absolute w-full left-0 flex-col transition-all duration-300">
        <div class="px-6 pt-4 pb-8 space-y-3" id="mobile-menu-links">
            <a href="/" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-[#0d47a1] transition-colors">Home</a>
            <a href="/about" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-[#0d47a1] transition-colors">About Us</a>
            <a href="/services" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-[#0d47a1] transition-colors">Services</a>
            <a href="/tools" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-[#0d47a1] transition-colors">Tools</a>
            <a href="/blogs" class="mobile-nav-link block px-4 py-3 rounded-xl text-base font-medium text-gray-700 hover:bg-gray-50 hover:text-[#0d47a1] transition-colors">Blogs</a>
            <a href="/contact" class="block mt-6 text-center bg-[#0d47a1] text-white px-6 py-4 rounded-xl font-bold text-lg w-full shadow-lg">Get Started</a>
        </div>
    </div>
</nav>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Smooth Mobile Menu Toggle
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const icon = btn.querySelector('i');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            menu.classList.toggle('flex');
            
            if (menu.classList.contains('hidden')) {
                icon.classList.remove('fa-times');
                icon.classList.add('fa-bars');
            } else {
                icon.classList.remove('fa-bars');
                icon.classList.add('fa-times');
            }
        });

        // 2. Dynamic Active Link Logic
        const currentPath = window.location.pathname;

        // Desktop Links
        const desktopLinks = document.querySelectorAll('.nav-link');
        desktopLinks.forEach(link => {
            const indicator = link.querySelector('.nav-indicator');
            if (link.getAttribute('href') === currentPath || (currentPath.startsWith('/blogs') && link.getAttribute('href') === '/blogs')) {
                link.classList.remove('text-gray-600', 'font-medium');
                link.classList.add('text-[#0d47a1]', 'font-bold');
                if(indicator) {
                    indicator.classList.remove('w-0');
                    indicator.classList.add('w-full');
                }
            }
        });

        // Mobile Links
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');
        mobileLinks.forEach(link => {
            if (link.getAttribute('href') === currentPath || (currentPath.startsWith('/blogs') && link.getAttribute('href') === '/blogs')) {
                link.classList.remove('text-gray-700', 'font-medium', 'hover:bg-gray-50');
                link.classList.add('text-[#0d47a1]', 'font-bold', 'bg-blue-50/80');
            }
        });
    });
</script>