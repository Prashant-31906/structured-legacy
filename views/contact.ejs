<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "name": "Contact Structured Legacy | Schedule a Strategy Consultation",
      "description": "Schedule a confidential strategy consultation with Structured Legacy for succession planning, wealth transfer, and business continuity.",
      "url": "https://www.structuredlegacy.com/contact"
    },
    {
      "@type": "ProfessionalService",
      "name": "Structured Legacy",
      "email": "ved@structuredlegacy.com",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "India"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "description": "By Appointment Only"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is there any obligation after the consultation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The purpose of the initial discussion is to understand your situation and determine whether Structured Legacy may be able to assist."
          }
        },
        {
          "@type": "Question",
          "name": "Who do you work with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We primarily work with business owners, promoters, family businesses, and high-net-worth families."
          }
        },
        {
          "@type": "Question",
          "name": "How are consultations conducted?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Consultations may be conducted virtually or in person, depending on circumstances and availability."
          }
        },
        {
          "@type": "Question",
          "name": "What topics can be discussed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Succession planning, wealth transfer, business continuity, family governance, estate liquidity, and wealth protection strategies."
          }
        }
      ]
    }
  ]
}
</script>

<!-- CUSTOM CSS FOR EFFECTS -->
<style>
    /* Lottie Loader */
    #loader { transition: opacity 0.6s ease-out; }
    
    /* Kinetic Typography */
    .kinetic-text {
        font-size: 8rem;
        font-weight: 900;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 2px rgba(255, 255, 255, 0.08);
        animation: scrollText 30s linear infinite;
        position: absolute;
        z-index: 0;
        pointer-events: none;
    }
    @keyframes scrollText { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* Neumorphism */
    .neumorphic {
        background: #e0e5ec;
        box-shadow: 9px 9px 16px rgb(163,177,198,0.6), -9px -9px 16px rgba(255,255,255, 0.6);
        border-radius: 24px;
    }

    /* Glassmorphism */
    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    .glass-dark {
        background: rgba(10, 25, 47, 0.8);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    /* Floating Animations */
    .animate-float-slow { animation: float 8s ease-in-out infinite; }
    .animate-float-fast { animation: float 5s ease-in-out infinite reverse; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

    /* Premium Input Autofill Fix */
    input:-webkit-autofill, textarea:-webkit-autofill {
        -webkit-box-shadow: 0 0 0 30px #f8fafc inset !important;
    }

    /* FAQ Accordion Hide Marker */
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }

    /* SweetAlert Premium Customization */
    .swal2-popup.premium-swal {
        border-radius: 2rem !important;
        border: 1px solid #f1f5f9 !important;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
    }
    .swal2-confirm.premium-btn {
        border-radius: 1rem !important;
        font-weight: 900 !important;
        padding: 1rem 2rem !important;
        text-transform: uppercase !important;
        letter-spacing: 0.05em !important;
        transition: all 0.3s ease !important;
    }
    .swal2-confirm.premium-btn:hover {
        transform: translateY(-2px) !important;
        box-shadow: 0 10px 15px -3px rgba(13, 71, 161, 0.3) !important;
    }
</style>

