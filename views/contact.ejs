<!-- INITIALIZATION SCRIPT -->
<script>
    // Remove Loader smoothly
    window.addEventListener('load', () => {
        setTimeout(() => {
            const loader = document.getElementById('loader');
            loader.style.opacity = '0';
            setTimeout(() => { loader.style.display = 'none'; }, 600);
        }, 1000); 
    });

    document.addEventListener("DOMContentLoaded", function() {
        // ScrollReveal Setup
        if(typeof ScrollReveal !== 'undefined') {
            ScrollReveal().reveal('.sr-bottom', { delay: 150, distance: '50px', origin: 'bottom', duration: 800, interval: 150 });
            ScrollReveal().reveal('.sr-left', { delay: 150, distance: '50px', origin: 'left', duration: 1000 });
            ScrollReveal().reveal('.sr-right', { delay: 150, distance: '50px', origin: 'right', duration: 1000 });
        }

        // SweetAlert2 Success Logic
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === 'true') {
            Swal.fire({
                title: '<strong style="color: #0d47a1;">Request Received</strong>',
                html: '<p style="color: #475569; font-size: 1.1rem;">Thank you for reaching out. A member of our advisory team will contact you shortly to arrange a confidential discussion.</p>',
                icon: 'success',
                iconColor: '#0d47a1',
                confirmButtonText: 'Understood',
                confirmButtonColor: '#0d47a1',
                buttonsStyling: false,
                customClass: {
                    popup: 'premium-swal',
                    confirmButton: 'bg-[#0d47a1] text-white premium-btn'
                }
            });
            // Clean up URL so it doesn't pop up again on refresh
            window.history.replaceState(null, null, window.location.pathname);
        }
    });
</script>

