<%- include('partials/header') %>

<main class="mt-[72px] bg-[#f8fafc] min-h-screen py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-white p-10 rounded-[2rem] shadow-xl border border-gray-100 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-[#0d47a1] to-blue-400"></div>
            
            <h2 class="text-3xl font-black text-gray-900 mb-2">Publish New Masterclass</h2>
            <p class="text-gray-500 mb-10 font-medium">Admin Dashboard: Fill out the details below to push a new article to the database.</p>
            
            <form action="/admin/add-blog" method="POST" class="space-y-6">
                <!-- Title -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Article Title</label>
                    <input type="text" name="title" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900" placeholder="e.g., 5 Strategies to Scale Your Business">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Category -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Category</label>
                        <select name="category" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900 cursor-pointer">
                            <option value="Wealth Creation">Wealth Creation</option>
                            <option value="Tax Strategy">Tax Strategy</option>
                            <option value="Legacy Planning">Legacy Planning</option>
                            <option value="Market Insights">Market Insights</option>
                        </select>
                    </div>
                    <!-- Image URL -->
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Featured Image URL</label>
                        <input type="url" name="image" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900" placeholder="https://images.unsplash.com/...">
                    </div>
                </div>

                <!-- Excerpt -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Short Excerpt (Preview)</label>
                    <textarea name="excerpt" rows="2" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900 resize-none" placeholder="A brief summary for the blog card..."></textarea>
                </div>

                <!-- Main Content -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Main Content (HTML Allowed)</label>
                    <textarea name="content" rows="12" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-medium text-gray-900 font-mono text-sm leading-relaxed" placeholder="Use <p>, <h2>, <strong> tags for formatting..."></textarea>
                </div>

                <button type="submit" class="w-full bg-[#0d47a1] text-white font-black py-5 rounded-xl shadow-lg hover:shadow-blue-900/40 hover:-translate-y-1 transition-all text-lg uppercase tracking-wider">
                    <i class="fas fa-cloud-upload-alt mr-2"></i> Publish Article
                </button>
            </form>
            
        </div>
    </div>
</main>

<%- include('partials/footer') %>