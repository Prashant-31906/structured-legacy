<%- include('partials/header') %>

<script src="https://cdn.jsdelivr.net/npm/@editorjs/editorjs@2.28.2"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/header@2.7.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/list@1.8.0"></script>
<script src="https://cdn.jsdelivr.net/npm/@editorjs/quote@2.5.0"></script>

<style>
    /* Custom Styling for the Editor.js Block */
    .ce-block__content, .ce-toolbar__content {
        max-width: 100%; /* Overrides default editorjs width limit */
    }
    .codex-editor {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.75rem;
        padding: 2rem;
        min-height: 400px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .codex-editor:focus-within {
        border-color: #0d47a1;
        box-shadow: 0 0 0 2px rgba(13, 71, 161, 0.1);
    }
</style>

<main class="mt-[72px] bg-[#f8fafc] min-h-screen py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-white p-10 md:p-14 rounded-[2rem] shadow-xl border border-gray-100 relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-[#0d47a1] to-[#d4af37]"></div>
            
            <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-2">Publish New Masterclass</h2>
            <p class="text-gray-500 mb-10 font-medium">Block-Based Editor: Type '/' for commands. Press Enter to create new blocks.</p>
            
            <form id="blogForm" action="/admin/add-blog" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Article Title</label>
                    <input type="text" name="title" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900 text-lg" placeholder="e.g., The Future of Wealth Transfer">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Category</label>
                        <select name="category" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900 cursor-pointer">
                            <option value="" disabled selected>Select a Category</option>
                            <option value="Wealth Creation">Wealth Creation</option>
                            <option value="Tax Strategy">Tax Strategy</option>
                            <option value="Legacy Planning">Legacy Planning</option>
                            <option value="Market Insights">Market Insights</option>
                            <option value="Succession">Succession</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Featured Image URL</label>
                        <input type="url" name="image" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900" placeholder="https://images.unsplash.com/...">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Short Excerpt (Preview)</label>
                    <textarea name="excerpt" rows="2" required class="w-full px-5 py-4 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-[#0d47a1] outline-none font-semibold text-gray-900 resize-none" placeholder="A brief summary for the blog card..."></textarea>
                </div>

                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Main Content (Block Editor)</label>
                    <div id="editorjs"></div>
                    <input type="hidden" name="content" id="content-hidden">
                </div>

                <button type="button" id="publishBtn" class="w-full mt-8 bg-[#0d47a1] text-white font-black py-5 rounded-xl shadow-lg hover:bg-blue-900 transition-all text-lg uppercase tracking-wider flex justify-center items-center">
                    Publish Article <i class="fas fa-paper-plane ml-3"></i>
                </button>
            </form>
            
        </div>
    </div>
</main>

<script>
    // Use window.onload to ensure all CDNs are completely downloaded before running
    window.addEventListener('load', function() {
        
        // 1. Check if CDN actually loaded
        if (typeof EditorJS === 'undefined') {
            console.error("EditorJS is not defined. CDN blocked or internet issue.");
            alert("Warning: Text editor failed to load. Please turn off Adblockers/Shields or check your connection.");
            return; // Stop execution here
        }

        let editor;
        
        try {
            // 2. Initialize Editor.js
            editor = new EditorJS({
                holder: 'editorjs',
                placeholder: 'Start writing your legacy masterclass here. Type / to see blocks...',
                tools: {
                    header: {
                        class: Header,
                        inlineToolbar: true,
                        config: { placeholder: 'Enter a header', levels: [2, 3, 4], defaultLevel: 2 }
                    },
                    list: {
                        class: List,
                        inlineToolbar: true
                    },
                    quote: {
                        class: Quote,
                        inlineToolbar: true,
                        config: { quotePlaceholder: 'Enter a quote', captionPlaceholder: 'Quote\'s author' },
                    }
                }
            });
        } catch (error) {
            console.error("Editor.js initialization failed:", error);
            alert("An error occurred while setting up the editor.");
        }

        // 3. Form Submit Interception
        const publishBtn = document.getElementById('publishBtn');
        const form = document.getElementById('blogForm');
        
        publishBtn.addEventListener('click', function(e) {
            e.preventDefault(); 

            if (!editor) {
                alert("Editor is not loaded properly. Cannot publish.");
                return;
            }

            // Save Editor.js data
            editor.save().then((outputData) => {
                // Prevent blank submission
                if(outputData.blocks.length === 0) {
                    alert("Please add some content to the masterclass before publishing!");
                    return;
                }
                
                // Convert JSON object to String and put in hidden input
                document.getElementById('content-hidden').value = JSON.stringify(outputData);
                
                // Trigger the actual form submission
                form.submit();
            }).catch((error) => {
                console.error('Saving failed: ', error);
                alert("Something went wrong while saving the editor content.");
            });
        });
    });
</script>

<%- include('partials/footer') %>