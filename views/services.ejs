                    <div class="absolute -top-6 -left-4 text-8xl font-black text-gray-200 opacity-50 select-none">4</div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-full bg-[#0d47a1] text-white flex items-center justify-center font-bold text-xl mb-6 shadow-md">
                            <i class="fas fa-level-up-alt"></i>
                        </div>
                        <h4 class="text-2xl font-bold text-gray-900 mb-3">Growth</h4>
                        <p class="text-gray-600 text-sm leading-relaxed">Continuous quarterly monitoring, SIP adjustments, and compliance audits to ensure permanent security.</p>
                    </div>
                </div>
            </div>
