                    <div class="absolute -top-6 -left-4 text-8xl font-black text-gray-200 opacity-50 select-none">3</div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-full bg-[#0d47a1] text-white flex items-center justify-center font-bold text-xl mb-6 shadow-md">
