                    <a href="/contact" class="bg-[#0d47a1] text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-blue-800 transition shadow-[0_10px_20px_rgba(13,71,161,0.3)] hover:-translate-y-1 inline-block">
