                        </li>
                        <li class="flex items-center text-gray-700 font-medium">
                            <i class="fas fa-check text-green-600 mr-3 bg-green-100 p-1 rounded-full text-xs"></i> 
                            Securing Family Lifestyle Indefinitely
                        </li>
                    </ul>
                    <a href="/contact" class="inline-flex items-center text-[#0d47a1] font-bold text-lg hover:text-blue-800 transition border-b-2 border-[#0d47a1] pb-1">
