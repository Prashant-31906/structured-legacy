                    <!-- Fixed max-w-md restricts card size so they stack neatly without breaking the container -->
                    <div class="swiper myCardsSwiper w-full max-w-md mx-auto lg:mx-0 pb-12">
                        <div class="swiper-wrapper">
                            <% if(typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
                                <% testimonials.forEach(testimony => { %>
                                    <div class="swiper-slide">
                                        <!-- Solid Dark Background Class 'solid-dark-card' blocks text bleed-through -->
                                        <div class="solid-dark-card p-8 md:p-10 rounded-[2rem] h-[400px] flex flex-col justify-between cursor-grab active:cursor-grabbing shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
