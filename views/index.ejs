<!-- SEO SCHEMA MARKUP (JSON-LD for Google & LLM Bots) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      "name": "Structured Legacy",
      "description": "Boutique Wealth Preservation & Legacy Advisory Firm helping business owners, promoters, and families protect wealth, plan succession, and ensure business continuity.",
      "url": "https://www.structuredlegacy.com",
      "logo": "https://www.structuredlegacy.com/images/structured-legacy-logo.png",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "123 Business Avenue, Corporate Park",
        "addressLocality": "New Delhi",
        "addressCountry": "IN"
      },
      "areaServed": "India",
      "knowsAbout": ["Succession Planning", "Wealth Preservation", "Business Continuity", "Estate Liquidity Planning", "Family Governance"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is succession planning and why do family businesses need it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Succession planning creates a structured roadmap for ownership and leadership transition. It ensures that a family business thrives across generations without operational disruptions or family disputes."
          }
        },
        {
          "@type": "Question",
          "name": "How does Structured Legacy help business owners protect and transfer wealth?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We design tax-efficient frameworks that convert business wealth into a structured personal balance sheet. This protects assets from unforeseen risks and moves wealth efficiently across generations while preserving control."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between Business Continuity and Estate Liquidity Planning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Business Continuity Planning protects the operational future of a company during a crisis. Estate Liquidity Planning ensures there is immediate cash available to handle taxes, stakeholder buyouts, and debt obligations without forced asset sales."
          }
        }
      ]
    }
  ]
}
</script>

<!-- CUSTOM CSS FOR EFFECTS -->
<style>
    /* Lottie Skeleton Loader Overlay */
    #loader { transition: opacity 0.6s ease-out; }
    
    /* Kinetic Typography */
    .kinetic-text {
        font-size: 8rem;
        font-weight: 900;
        white-space: nowrap;
        color: transparent;
        -webkit-text-stroke: 2px rgba(255, 255, 255, 0.08);
        animation: scrollText 30s linear infinite;
        position: absolute;
        z-index: 0;
        pointer-events: none;
    }
    @keyframes scrollText { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* Infinite Marquee */
    .marquee-container { overflow: hidden; white-space: nowrap; position: relative; }
    .marquee-content { display: inline-flex; animation: marquee 25s linear infinite; }
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    /* Neumorphism */
    .neumorphic {
        background: #e0e5ec;
        box-shadow: 9px 9px 16px rgb(163,177,198,0.6), -9px -9px 16px rgba(255,255,255, 0.6);
        border-radius: 24px;
    }
    
    /* Clickable 3D Flip Cards */
    .perspective-1000 { perspective: 1000px; }
    .flip-card-inner { transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .flip-card.flipped .flip-card-inner { transform: rotateY(180deg); }
    .backface-hidden { backface-visibility: hidden; }
    .rotate-y-180 { transform: rotateY(180deg); }

    /* Glassmorphism Refined */
    .glass {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
    
    /* Solid Dark for Cards to Prevent Overlap Bleed */
    .solid-dark-card {
        background: linear-gradient(145deg, #112240, #0a192f);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Floating Animations */
    .animate-float-slow { animation: float 8s ease-in-out infinite; }
    .animate-float-fast { animation: float 5s ease-in-out infinite reverse; }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }

    /* FAQ Accordion Hide Marker */
    details > summary { list-style: none; }
    details > summary::-webkit-details-marker { display: none; }

    /* Custom Swiper Navigation styling */
    .swiper-button-next::after, .swiper-button-prev::after { font-size: 1.5rem !important; font-weight: 900; }
    .blog-nav-btn { background: white; width: 40px; height: 40px; border-radius: 50%; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
</style>

