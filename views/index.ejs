                                                </div>
                                                <p class="text-gray-200 text-base md:text-lg italic mb-6 leading-relaxed line-clamp-5">"<%= testimony.message %>"</p>
                                            </div>
                                            <div class="flex items-center border-t border-white/10 pt-6 mt-auto">
                                                <div class="w-14 h-14 bg-gradient-to-br from-blue-400 to-blue-700 text-white rounded-full flex items-center justify-center font-bold text-xl shadow-lg border-2 border-white/30 flex-shrink-0">
                                                    <%= testimony.name.charAt(0).toUpperCase() %>
                                                </div>
                                                <div class="ml-4 overflow-hidden">
                                                    <h5 class="font-bold text-white text-lg truncate"><%= testimony.name %></h5>
                                                    <span class="text-xs font-bold text-blue-400 uppercase tracking-wider block truncate"><%= testimony.designation %></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <!-- Fallback Card -->
                                <div class="swiper-slide">
                                    <div class="solid-dark-card p-8 rounded-[2rem] h-[400px] flex items-center justify-center shadow-[0_10px_30px_rgba(0,0,0,0.6)]">
                                        <p class="text-gray-400 text-lg italic text-center">"Be the first to share your experience with Structured Legacy."</p>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                        <div class="swiper-pagination mt-4"></div>
                    </div>
                </div>

                <!-- Form Section -->
                <div class="lg:col-span-6 sr-right">
                    <div class="bg-white p-8 md:p-10 rounded-[2.5rem] shadow-2xl relative w-full max-w-lg mx-auto lg:mx-0">
                        <div class="absolute -top-6 -right-6 w-24 h-24 bg-blue-100 rounded-full z-0 animate-ping opacity-50"></div>
                        <div class="relative z-10">
                            <h3 class="text-3xl font-black text-gray-900 mb-2">Share Your Story</h3>
                            <p class="text-gray-500 mb-8 font-medium">Your feedback shapes our legacy. Publish it directly to our home page.</p>
                            
